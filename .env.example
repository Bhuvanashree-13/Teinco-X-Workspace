DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# Railway MySQL may expose MYSQL_URL. The app accepts either DATABASE_URL or MYSQL_URL.
# MYSQL_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# If Railway provides separate values instead, the app can also build from:
# MYSQLHOST=""
# MYSQLPORT="3306"
# MYSQLUSER=""
# MYSQLPASSWORD=""
# MYSQLDATABASE=""
JWT_SECRET="replace-with-a-long-random-secret"
# Google OAuth Web application client ID (public identifier; no client secret needed).
# Configure authorized JavaScript origins in Google Cloud before enabling.
GOOGLE_CLIENT_ID=""
SEED_DEMO_DATA="false"
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
