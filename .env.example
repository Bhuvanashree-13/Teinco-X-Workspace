DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# Railway MySQL may expose MYSQL_URL. The app accepts either DATABASE_URL or MYSQL_URL.
# MYSQL_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# If Railway provides separate values instead, the app can also build from:
# MYSQLHOST=""
# MYSQLPORT="3306"
# MYSQLUSER=""
# MYSQLPASSWORD=""
# MYSQLDATABASE=""
JWT_SECRET="replace-with-a-long-random-secret"
# Google OAuth Web application client ID (public identifier; no client secret needed).
# Configure authorized JavaScript origins in Google Cloud before enabling.
GOOGLE_CLIENT_ID=""
SEED_DEMO_DATA="false"
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# SMTP mail delivery for payslip and subscription automations.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Teinco-X <no-reply@example.com>"
# Public base URL used in emailed payslip download links.
APP_PUBLIC_URL=""

# Vyom: server-side Gemini API. Never use a VITE_ variable for the key.
GEMINI_API_KEY=""
VYOM_GEMINI_MODEL="gemini-2.5-flash"
VYOM_TIMEOUT_MS="180000"
# Reuse a stable workspace context for CAG-style conversations (30–300 seconds).
VYOM_CONTEXT_CACHE_MS="120000"
